        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="In this study you will see words one at a time.&amp;#10;The COLOUR of each word tells you what to do:&amp;#10;&amp;#10;GREEN = say the word OUT LOUD&amp;#10;YELLOW = MOUTH the word (move your lips, no sound)&amp;#10;PINK = read the word SILENTLY in your head&amp;#10;&amp;#10;Try to remember all the words. Your memory will be tested later.&amp;#10;&amp;#10;First, a short practice. Press SPACE to start." valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
